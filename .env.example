# Copy to `.env` in the project root (never commit `.env`).
# Used by `npm run test:live` — see README "Live API verification".

# Service instance URL: https://<hostname>/instances/<tenant_id> (Profile → Settings → API details).
WXO_BASE_URL=

# IBM Cloud API key (Manage > Access (IAM) > API keys). Exchanged for an IAM token before calling the API.
WXO_API_KEY=

# Optional: path for the live GET (default /v1/orchestrate/agents).
# WXO_LIVE_PATH=/v1/orchestrate/agents
