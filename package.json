{
  "name": "n8n-nodes-watsonx-orchestrate",
  "version": "0.1.9",
  "description": "n8n community node for IBM Watsonx Orchestrate agent execution.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node ./scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:debug:auth-header": "vitest run test/debug/auth-header.debug.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n-nodes-watsonx-orchestrate",
    "watsonx",
    "ibm",
    "workflow-automation"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreswagner/n8n-wxo-agent.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/WatsonxOrchestrateApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WatsonxOrchestrate/WatsonxOrchestrate.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^16.5.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.16.0"
  }
}
